{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml", "eslint.config.js", "packages/config/tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["TZ"]
    },
    "//#lint:root": {
      "inputs": ["scripts/**", "e2e/**", "eslint.config.js", "playwright.config.ts"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:public": {
      "cache": false,
      "persistent": true
    },
    "dev:admin": {
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    },
    "//#typecheck:root": {
      "inputs": ["e2e/**", "playwright.config.ts", "tsconfig.json"],
      "outputs": []
    }
  }
}
