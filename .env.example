# =====================================================================================================
# Masjid Connect — environment variables (template; NO real values here, ever)
# Source of truth for validation: packages/shared/src/env.ts  ·  Spec: docs/01_ARCHITECTURE.md §7
#
# Where real values live (CLAUDE.md §8):
#   - local dev:  generated by `pnpm setup:local` into git-ignored .env.local.<process> files
#   - staging/production: one file per process on the VPS, root-owned, mode 600:
#       /etc/masjid-connect/<env>/api-public.env, api-admin.env, worker.env, migrate.env
#   - client (VITE_PUBLIC_*): build-time values in CI; they end up in the public JS bundle, so they
#     must never be secret.
#
# Each process REFUSES TO START if a variable it must not hold is present (credential split,
# DECISIONS #7). So never copy the whole file into one process's env — use only that process's section
# plus the "common" section.
#
# Variables marked [optional locally] may be left out when APP_ENV=local (filesystem storage and mock
# Bunny/Turnstile/Cloudflare adapters are used instead); they are required on staging and production.
#
# Generating secrets (run on your own machine or the server, never paste results into chat):
#   32-byte base64 key:   openssl rand -base64 32
#   VAPID key pair:       generated by Claude Code's script in Phase 4 — back the private key up safely
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# Common — every server process (api-public, api-admin, worker). The migrator only needs the first five.
# -----------------------------------------------------------------------------------------------------

# development | test | production. Must be "production" on staging and production.
NODE_ENV=
# local | staging | production
APP_ENV=
# fatal | error | warn | info | debug | trace | silent   (default: info)
LOG_LEVEL=
# Sentry DSN for this process (https). Optional — Sentry is a no-op without it.
SENTRY_DSN=
# MongoDB database name, e.g. masjid_connect (letters, digits, _ or -; max 38 chars)
MONGODB_DB_NAME=
# Build release (git SHA). Set by the Docker image — do not set it in env files. Default: dev
RELEASE=
# Public origins without a path. https required outside local. e.g. https://app-staging.<domain>
APP_ORIGIN=
ADMIN_ORIGIN=
MEDIA_ORIGIN=
# cloudflare (staging/production — trust Cloudflare's client IP header) | none (local)
TRUSTED_PROXY_MODE=


# -----------------------------------------------------------------------------------------------------
# api-public — serves app.<domain>/api/v1/*. Least privileged: read-only views + device data.
# MUST NOT have: MONGODB_URI_ADMIN/SYSTEM/MIGRATOR, BUNNY_API_KEY, S3_*_KEY*, VAPID_PRIVATE_KEY,
#                CF_API_TOKEN_PURGE, SESSION_PEPPER, FIELD_ENCRYPTION_KEY*
# -----------------------------------------------------------------------------------------------------

# MongoDB user mc_public. mongodb+srv://mc_public:<password>@<cluster>/  (TLS required outside local)
MONGODB_URI_PUBLIC=
# Redis ACL user rl_public (rate-limit keys only). redis://rl_public:<password>@redis:6379
REDIS_URL_PUBLIC=
# Cloudflare Turnstile secret key [optional locally]
TURNSTILE_SECRET=
# Bunny Stream token-authentication key — only signs playback URLs, cannot manage videos [optional locally]
BUNNY_TOKEN_KEY=
# Bunny CDN hostname, no scheme, e.g. vz-xxxx.b-cdn.net [optional locally]
BUNNY_CDN_HOST=
# Listen port (local default 8787)
PORT=


# -----------------------------------------------------------------------------------------------------
# api-admin — serves admin.<domain>/api/admin/*, /api/super/*, /api/hooks/*
# MUST NOT have: MONGODB_URI_SYSTEM/MIGRATOR/PUBLIC, VAPID_PRIVATE_KEY, CF_API_TOKEN_PURGE
# -----------------------------------------------------------------------------------------------------

# MongoDB user mc_admin
MONGODB_URI_ADMIN=
# Redis ACL user "admin" (rate limits, passkey challenges, job enqueueing)
REDIS_URL_ADMIN=
# Session token pepper: base64, ≥ 32 random bytes (openssl rand -base64 32)
SESSION_PEPPER=
# AES-256-GCM key for admin phone numbers / grievance contacts: base64, exactly 32 bytes
FIELD_ENCRYPTION_KEY=
# Short id of the key above, e.g. k1 (a-z, 0-9, -). Stored next to each encrypted value for rotation.
FIELD_ENCRYPTION_KEY_ID=
# Previous keys during rotation, optional: id:base64,id:base64
FIELD_ENCRYPTION_OLD_KEYS=
# Passkey relying-party id = hostname of ADMIN_ORIGIN, e.g. admin-staging.<domain>
RP_ID=
# Bunny Stream library id (numeric) and API key [optional locally]
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# Bunny playback token key and CDN host (as in api-public) [optional locally]
BUNNY_TOKEN_KEY=
BUNNY_CDN_HOST=
# Shared secret for verifying Bunny webhooks [optional locally]
BUNNY_WEBHOOK_SECRET=
# AWS S3 — region must be ap-south-1 outside local. IAM user scoped to the admin's prefixes/actions. [optional locally]
S3_REGION=
S3_MEDIA_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID_ADMIN=
S3_SECRET_ACCESS_KEY_ADMIN=
# Cloudflare Turnstile secret key [optional locally]
TURNSTILE_SECRET=
# VAPID public key (base64url, 65 bytes) — public, used for admin alert push subscriptions
VAPID_PUBLIC_KEY=
# Hold before a new UPI ID goes live, in minutes. ≥ 1440 (24 h) enforced in production.
PAYMENT_HOLD_MINUTES=
# Listen port (local default 8788)
PORT=


# -----------------------------------------------------------------------------------------------------
# worker — background jobs (push fan-out, schedules, retention). The only holder of the VAPID private key.
# MUST NOT have: MONGODB_URI_PUBLIC/ADMIN/MIGRATOR, SESSION_PEPPER
# -----------------------------------------------------------------------------------------------------

# MongoDB user mc_system
MONGODB_URI_SYSTEM=
# Redis ACL user "worker" (queues, push sent-sets, alerts)
REDIS_URL_WORKER=
# VAPID key pair (base64url). Never rotate the private key — it would break every subscription. Back it up.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://…
VAPID_SUBJECT=
# Bunny library id + API key (deleting expired videos) [optional locally]
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
# AWS S3 (region ap-south-1 outside local). IAM user scoped to delete/log-archive actions. [optional locally]
S3_REGION=
S3_MEDIA_BUCKET=
S3_PRIVATE_BUCKET=
S3_LOG_BUCKET=
S3_ACCESS_KEY_ID_WORKER=
S3_SECRET_ACCESS_KEY_WORKER=
# Cloudflare API token with ONLY "Cache Purge" permission on the zone, and the zone id (32 hex) [optional locally]
CF_API_TOKEN_PURGE=
CF_ZONE_ID=
# Same field-encryption key(s) as api-admin (retention anonymisation)
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=
FIELD_ENCRYPTION_OLD_KEYS=
# Same value as api-admin
PAYMENT_HOLD_MINUTES=


# -----------------------------------------------------------------------------------------------------
# migrate — one-off migration container (CI deploys). Needs NODE_ENV, APP_ENV, LOG_LEVEL, SENTRY_DSN,
# MONGODB_DB_NAME, RELEASE from "common" plus:
# MUST NOT have any other database URI or any service secret.
# -----------------------------------------------------------------------------------------------------

# MongoDB user mc_migrator (createIndex, collMod, create views). Never present in a running app container.
MONGODB_URI_MIGRATOR=


# -----------------------------------------------------------------------------------------------------
# Client build-time variables (Vite). ONLY the VITE_PUBLIC_ prefix is allowed; anything else that starts
# with VITE_ fails the build. These values are PUBLIC (they ship in the JavaScript bundle).
# -----------------------------------------------------------------------------------------------------

# Same-origin API path: /api/v1 (musalli app) or /api/admin (admin app)
VITE_PUBLIC_API_BASE=
# VAPID public key (same as the server's VAPID_PUBLIC_KEY)
VITE_PUBLIC_VAPID_PUBLIC_KEY=
# Turnstile site key (musalli app only)
VITE_PUBLIC_TURNSTILE_SITE_KEY=
# Browser Sentry DSN, optional
VITE_PUBLIC_SENTRY_DSN=
# https origins (http://localhost allowed for local dev)
VITE_PUBLIC_APP_ORIGIN=
VITE_PUBLIC_MEDIA_ORIGIN=
