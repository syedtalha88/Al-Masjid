# Hourly encrypted container-log archive (deploys also archive before removing containers), kept 200 days (CERT-In ≥ 180 — DECISIONS #40).
[Unit]
Description=Masjid Connect: archive container logs
After=docker.service
OnFailure=mc-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/masjid-connect/log-archive.sh
# A success clears an earlier failure marker (re-review L6).
ExecStartPost=/bin/rm -f /var/lib/masjid-connect/failures/%n
