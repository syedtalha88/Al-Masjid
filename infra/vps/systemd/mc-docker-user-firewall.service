# Re-apply the Cloudflare-only rule after Docker starts (Docker creates DOCKER-USER; the rule must exist before
# any container publishes 443).
[Unit]
Description=Masjid Connect: Cloudflare-only 443 in DOCKER-USER
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/masjid-connect/infra/vps/cloudflare-ips.sh --apply

[Install]
WantedBy=multi-user.target
