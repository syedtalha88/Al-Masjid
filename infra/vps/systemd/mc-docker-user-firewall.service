# Re-apply the Cloudflare-only rule (ipsets are lost on reboot) right after Docker starts and creates DOCKER-USER.
# Restarted with Docker (PartOf). The few seconds before it runs are covered by Authenticated Origin Pulls.
[Unit]
Description=Masjid Connect: Cloudflare-only 443 in DOCKER-USER
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/masjid-connect/infra/vps/cloudflare-ips.sh --apply

[Install]
WantedBy=multi-user.target
