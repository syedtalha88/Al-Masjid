# Caddy — static SPAs + reverse proxy for both origins (01 §1–2, §5.2; DECISIONS #21).
# One file for every environment; differences come from environment variables:
#   APP_HOST, ADMIN_HOST      e.g. app.localhost / admin.localhost (local stack) or app-staging.<domain>
#   CADDY_TLS                 local  → Caddy's internal CA (local stack only)
#                             origin → Cloudflare Origin CA certificate + Authenticated Origin Pulls
#                                      (Caddy rejects TLS without Cloudflare's client certificate — 04 §12.2)
#   API_PUBLIC_UPSTREAM, API_ADMIN_UPSTREAM   e.g. api-public:8787, api-admin:8788
#   APP_ROBOTS                X-Robots-Tag of the app origin: "noindex, nofollow" on staging, default "all"
# Security headers for static files (exact 04 §7 set incl. CSP) are completed in T0.5.

{
	# No admin API inside the container (nothing to attack; config changes = redeploy).
	admin off
	# Caddy runs as an unprivileged user, so it listens on high ports; the host maps 443 → 8443, 80 → 8080.
	https_port 8443
	http_port 8080
}

# Container healthcheck only: plain HTTP on loopback inside the container, never published.
http://:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

(tls-local) {
	tls internal
}

(tls-origin) {
	tls /certs/origin.pem /certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /certs/cloudflare-origin-pull-ca.pem
		}
	}
}

# Common to both origins.
(common) {
	import tls-{$CADDY_TLS}
	encode zstd gzip
	header -Server
	header -X-Powered-By

}

# Security headers for everything Caddy serves itself (04 §7, T0.5). Proxied API responses carry their own, set
# by Express (packages/api security-headers.ts). HSTS without preload until launch (DECISIONS #29);
# Permissions-Policy without interest-cohort (#33).
(security-headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), geolocation=(self), accelerometer=(self), gyroscope=(self), magnetometer=(self), microphone=(), payment=(), usb=(), bluetooth=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-site"
		X-Frame-Options "DENY"
	}
}

# CSP for the musalli app: Turnstile (device registration, reports, grievances), the self-hosted QR reader's WebAssembly
# ('wasm-unsafe-eval' — compiling only, no JS eval; DECISIONS #94) and the YouTube embed after a
# tap (DECISIONS #39). Trusted Types: only the `default` policy (apps/*/src/trusted-types.ts). MEDIA_ORIGIN = the
# image host; CSP_CONNECT_EXTRA = extra connect-src sources (the Sentry ingest host, T0.13), empty by default.
(csp-app) {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: {$MEDIA_ORIGIN}; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com {$CSP_CONNECT_EXTRA:}; frame-src https://challenges.cloudflare.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types default"
}

# CSP for the admin app: the same without Turnstile and YouTube (unused there — 04 §7 "minus … where unused").
(csp-admin) {
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: {$MEDIA_ORIGIN}; media-src 'self' blob:; font-src 'self'; connect-src 'self' {$CSP_CONNECT_EXTRA:}; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types default"
}

# Caddy's own JSON 404 for unknown /api paths: the API header set (04 §7 "API JSON responses").
(api-not-found) {
	import security-headers
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	header Content-Type "application/problem+json"
	header Cache-Control "no-store"
	respond `{"type":"urn:masjid-connect:problem:not-found","title":"Not Found","status":404,"code":"NOT_FOUND"}` 404
}

# API reverse proxy (args[0] = upstream, e.g. api-public:8787 — two replicas behind Docker DNS).
(api-proxy) {
	# Caddy adds `Via: 1.1 Caddy` to proxied responses itself, after `header_down` runs, so `header_down -Via` cannot
	# remove it; a deleting `header` is deferred to the moment the response is written (found 19 Oct 2026 — Cloudflare
	# had been hiding it on staging). It would name the server software (04 §7, re-review L5/V-30).
	header -Via
	reverse_proxy {args[0]} {
		# Rolling restarts (infra/vps/deploy.sh): a dial to a container that just left is retried (Docker DNS then
		# answers with the remaining replicas) instead of failing the request (PHASE_00 T0.14).
		lb_try_duration 5s
		lb_try_interval 250ms
		# The request id is Caddy's; a client-supplied one is never trusted for log correlation (review S-L11).
		header_up X-Request-Id {http.request.uuid}
		# The site-level X-Robots-Tag is the only one — the API's own copy would make it appear twice on admin
		# responses (V-30).
		header_down -X-Robots-Tag
		transport http {
			# Shorter than Node's keep-alive (65 s), so Caddy — not Node — closes idle connections (review S-L12).
			keepalive 30s
		}
	}
}

# Static SPA: hashed assets immutable, entry points always revalidated (01 §5.2), SPA fallback.
(spa) {
	root * {args[0]}

	@immutable {
		path /assets/*
		file
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	# An unknown /assets/* URL is a plain, uncacheable 404 — never the app shell under an immutable URL (S-L6).
	@missingAsset {
		path /assets/*
		not file
	}
	header @missingAsset Cache-Control "no-store"

	@entry path / /index.html /boot.js /sw.js /manifest.webmanifest /offline.html
	header @entry Cache-Control "no-cache"

	# PWA (T0.11): the manifest's registered type; icons and launch screens are not hashed → one day.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"
	@pwaImages path /icons/* /splash/*
	header @pwaImages Cache-Control "public, max-age=86400"

	@spaFallback {
		not path /assets/*
		not file
	}
	rewrite @spaFallback /index.html
	file_server {
		precompressed br gzip
	}
}

https://{$APP_HOST} {
	import common
	# Staging (and the local stack): "noindex, nofollow" (PHASE_00 T0.14); production: unset → "all".
	header X-Robots-Tag "{$APP_ROBOTS:all}"

	# Public API → api-public (×2 replicas in staging/production; Docker DNS round-robin).
	handle /api/v1/* {
		import api-proxy {$API_PUBLIC_UPSTREAM}
	}
	# Any other /api path on this origin does not exist (never falls through to the SPA).
	handle /api/* {
		import api-not-found
	}
	# Source maps are uploaded to Sentry only; never served (T0.13). Must precede the SPA catch-all.
	@maps path *.map
	handle @maps {
		respond 404
	}
	# Link previews (03 §3, DECISIONS #91): the shell with OpenGraph tags from api-public for /m/<code> and
	# /p/<publicId>. Strict match — the template reads only these two captures. Crawlers get it cached 5 minutes.
	# The template file itself is never served directly.
	@ogFile path /og.html /og.html.br /og.html.gz
	handle @ogFile {
		respond 404
	}
	@og path_regexp og ^/(m|p)/([A-Za-z0-9_-]{1,32})/?$
	handle @og {
		import security-headers
		import csp-app
		header Cache-Control "public, max-age=0, s-maxage=300"
		root * /srv/app
		rewrite * /og.html
		templates
		file_server
	}
	handle {
		import security-headers
		import csp-app
		import spa /srv/app
	}
}

https://{$ADMIN_HOST} {
	import common
	header X-Robots-Tag "noindex, nofollow"

	@adminApi path /api/admin/* /api/super/* /api/hooks/*
	handle @adminApi {
		import api-proxy {$API_ADMIN_UPSTREAM}
	}
	handle /api/* {
		import api-not-found
	}
	# Source maps are uploaded to Sentry only; never served (T0.13). Must precede the SPA catch-all.
	@maps path *.map
	handle @maps {
		respond 404
	}
	handle {
		import security-headers
		import csp-admin
		import spa /srv/admin
	}
}
