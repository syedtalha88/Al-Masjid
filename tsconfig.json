{
  "extends": "./packages/config/tsconfig.node.json",
  "compilerOptions": {
    // Playwright specs pass callbacks that run in the browser (page.evaluate / addInitScript).
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["playwright.config.ts", "e2e", "scripts/**/*.ts"],
  // Load tests import the server packages: Node types only (scripts/load/tsconfig.json).
  "exclude": ["scripts/load"]
}
