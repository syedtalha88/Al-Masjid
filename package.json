{
  "name": "masjid-connect",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=12.10.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "node scripts/compose.mjs dev up && turbo run dev dev:public dev:admin dev:worker",
    "dev:app": "node scripts/compose.mjs dev up && turbo run dev dev:public --filter=@mc/app --filter=@mc/server",
    "dev:admin": "node scripts/compose.mjs dev up && turbo run dev dev:admin dev:worker --filter=@mc/admin --filter=@mc/server",
    "db:start": "node scripts/compose.mjs dev up",
    "db:reset": "node scripts/not-yet.mjs db:reset \"Phase 1\"",
    "db:migrate": "node scripts/not-yet.mjs db:migrate \"Phase 1\"",
    "db:test": "node scripts/not-yet.mjs db:test \"Phase 1\"",
    "db:schema:check": "node scripts/not-yet.mjs db:schema:check \"Phase 1\"",
    "db:verify-roles": "node scripts/not-yet.mjs db:verify-roles \"Phase 1\"",
    "test": "turbo run test",
    "test:int": "node scripts/not-yet.mjs test:int T0.12",
    "test:e2e": "playwright test",
    "i18n:check": "pnpm --filter @mc/i18n i18n:check",
    "size": "node scripts/not-yet.mjs size T0.12",
    "lhci": "node scripts/not-yet.mjs lhci T0.12",
    "stack:up": "pnpm --filter @mc/app --filter @mc/admin build && node scripts/compose.mjs stack up --build",
    "infra:check": "node scripts/not-yet.mjs infra:check T0.14",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:quick": "turbo run typecheck typecheck:root lint lint:root test && prettier --check .",
    "verify": "turbo run typecheck typecheck:root lint lint:root test && prettier --check . && pnpm i18n:check && pnpm db:test && pnpm test:int && pnpm test:e2e && pnpm size && pnpm lhci",
    "lint:root": "eslint scripts e2e eslint.config.js playwright.config.ts --max-warnings 0 --no-warn-ignored",
    "setup:local": "node scripts/setup-local.mjs",
    "db:stop": "node scripts/compose.mjs dev down",
    "stack:down": "node scripts/compose.mjs stack down",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "i18n:review": "pnpm --filter @mc/i18n i18n:review"
  },
  "devDependencies": {
    "@mc/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "lefthook": "2.1.17",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
