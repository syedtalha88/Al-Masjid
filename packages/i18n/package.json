{
  "name": "@mc/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Locales (en, hi, ur, te), i18next setup, formatters, RTL boot, i18n:check (09_I18N).",
  "exports": {
    ".": "./src/index.ts",
    "./locales": "./src/locales.ts",
    "./react": "./src/react.tsx",
    "./vite": "./src/vite-plugin.ts",
    "./format": "./src/format.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "i18n:check": "tsx tools/cli.ts check",
    "i18n:review": "tsx tools/cli.ts review"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "i18next-icu": "2.5.0",
    "intl-messageformat": "12.1.3",
    "react-i18next": "17.0.16"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@mc/config": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
