{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    // Playwright fixtures pass callbacks that run in the browser (addInitScript / waitForFunction).
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["vitest.config.ts", "src/**/*.js", "src/**/*.ts", "test/**/*.ts"]
}
