{
  "name": "@mc/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod API contracts, error types, env schema (T0.2), brand, constants.",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./brand": "./src/brand.ts",
    "./brand-mark": "./src/brand-mark.ts",
    "./pwa": "./src/pwa.ts",
    "./clock": "./src/clock.ts",
    "./browser": "./src/browser.ts",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/public": "./src/contracts/public.ts",
    "./contracts/problem": "./src/contracts/problem.ts",
    "./errors": "./src/errors.ts",
    "./http": "./src/http/request-json.ts",
    "./testing/msw": "./src/testing/msw.ts",
    "./observability": "./src/observability/scrub.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@mc/config": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "msw": "2.15.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
