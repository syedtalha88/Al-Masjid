{
  "openapi": "3.1.0",
  "info": {
    "title": "Masjid Connect API",
    "version": "1.0.0",
    "description": "Public API (`/api/v1`, api-public) and admin API (`/api/admin`, api-admin). Errors: RFC 9457 problem+json."
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "api-public",
              "api-admin"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "version"
        ]
      }
    },
    "parameters": {}
  },
