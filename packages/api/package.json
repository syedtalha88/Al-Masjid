{
  "name": "@mc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express apps (createPublicApp / createAdminApp), routes, services, jobs, hooks. From T0.4.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./test-hooks": "./src/test-hooks/index.ts",
    "./jobs/bootstrap-super-admin": "./src/jobs/bootstrap-super-admin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "node ../../scripts/vitest-int.mjs --coverage",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "devDependencies": {
    "@mc/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "ioredis": "6.0.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@mc/db": "workspace:*",
    "@mc/shared": "workspace:*",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.1",
    "zod": "4.6.5"
  }
}
