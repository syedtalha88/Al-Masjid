{
  "name": "@mc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MongoDB clients, schema, policy layer, scoped repositories, migrations. From Phase 1.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
