{
  "collections": [
    {
      "name": "masjids",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "follow_code",
          "name",
          "name_i18n",
          "area",
          "city",
          "state",
          "address",
          "lat",
          "lng",
          "status",
          "calc_method",
          "asr_madhab",
          "show_chanda",
          "chanda_week_start",
          "sehri_precaution_min",
          "iftar_precaution_min",
          "push_daily_quota",
          "content_version",
          "admin_count",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "follow_code": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "8"
            },
            "pattern": "^[0-9A-HJKMNP-TV-Z]{8}$"
          },
          "name": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "120"
            },
            "minLength": {
              "$numberInt": "1"
            }
          },
          "name_i18n": {
            "bsonType": "object",
            "additionalProperties": false,
            "properties": {
              "hi": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "ur": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "te": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              }
            }
          },
          "area": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "80"
            }
          },
          "city": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "80"
            },
            "minLength": {
              "$numberInt": "1"
            }
          },
          "state": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "80"
            },
            "minLength": {
              "$numberInt": "1"
            }
          },
          "address": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "300"
            }
          },
          "lat": {
            "bsonType": ["double", "int"],
            "minimum": {
              "$numberInt": "6"
            },
            "maximum": {
              "$numberDouble": "37.5"
            }
          },
          "lng": {
            "bsonType": ["double", "int"],
            "minimum": {
              "$numberInt": "68"
            },
            "maximum": {
              "$numberDouble": "97.5"
            }
          },
          "photo_key": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "200"
            }
          },
          "photo_thumbhash": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "64"
            }
          },
          "status": {
            "bsonType": "string",
            "enum": ["pending", "active", "suspended", "deleted"]
          },
          "verified_at": {
            "bsonType": "date"
          },
          "calc_method": {
            "bsonType": "string",
            "enum": ["karachi", "mwl", "isna", "egypt", "umm_al_qura", "other_custom"]
          },
          "asr_madhab": {
            "bsonType": "string",
            "enum": ["hanafi", "shafi"]
          },
          "hijri_offset": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "-2"
            },
            "maximum": {
              "$numberInt": "2"
            }
          },
          "show_chanda": {
            "bsonType": "bool"
          },
          "chanda_week_start": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "1"
            },
            "maximum": {
              "$numberInt": "7"
            }
          },
          "ramadan_start": {
            "bsonType": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "ramadan_end": {
            "bsonType": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "sehri_precaution_min": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "15"
            }
          },
          "iftar_precaution_min": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "10"
            }
          },
          "push_daily_quota": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "50"
            }
          },
          "content_version": {
            "bsonType": "long",
            "minimum": {
              "$numberLong": "1"
            },
            "maximum": {
              "$numberLong": "9007199254740991"
            }
          },
          "admin_count": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "5"
            }
          },
          "removals_90d_cache": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "10000"
            }
          },
          "adhkar": {
            "bsonType": "object",
            "required": ["enabled", "library_ids"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "bsonType": "bool"
              },
              "library_ids": {
                "bsonType": "array",
                "items": {
                  "bsonType": "binData"
                },
                "maxItems": {
                  "$numberInt": "30"
                },
                "uniqueItems": true
              }
            }
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          },
          "deleted_at": {
            "bsonType": "date"
          }
        }
      },
      "indexes": [
        {
          "name": "follow_code_unique",
          "key": {
            "follow_code": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "status_created",
          "key": {
            "status": {
              "$numberInt": "1"
            },
            "created_at": {
              "$numberInt": "-1"
            }
          }
        },
        {
          "name": "name",
          "key": {
            "name": {
              "$numberInt": "1"
            }
          }
        },
        {
          "name": "city",
          "key": {
            "city": {
              "$numberInt": "1"
            }
          }
        }
      ]
    }
  ],
  "views": [
    {
      "name": "v_pub_masjids",
      "viewOn": "masjids",
      "pipeline": [
        {
          "$match": {
            "status": "active",
            "deleted_at": {
              "$exists": false
            }
          }
        },
        {
          "$project": {
            "follow_code": {
              "$numberInt": "1"
            },
            "name": {
              "$numberInt": "1"
            },
            "name_i18n": {
              "$numberInt": "1"
            },
            "area": {
              "$numberInt": "1"
            },
            "city": {
              "$numberInt": "1"
            },
            "state": {
              "$numberInt": "1"
            },
            "address": {
              "$numberInt": "1"
            },
            "lat": {
              "$numberInt": "1"
            },
            "lng": {
              "$numberInt": "1"
            },
            "photo_key": {
              "$numberInt": "1"
            },
            "photo_thumbhash": {
              "$numberInt": "1"
            },
            "verified_at": {
              "$numberInt": "1"
            },
            "calc_method": {
              "$numberInt": "1"
            },
            "asr_madhab": {
              "$numberInt": "1"
            },
            "hijri_offset": {
              "$numberInt": "1"
            },
            "show_chanda": {
              "$numberInt": "1"
            },
            "chanda_week_start": {
              "$numberInt": "1"
            },
            "ramadan_start": {
              "$numberInt": "1"
            },
            "ramadan_end": {
              "$numberInt": "1"
            },
            "sehri_precaution_min": {
              "$numberInt": "1"
            },
            "iftar_precaution_min": {
              "$numberInt": "1"
            },
            "adhkar": {
              "$numberInt": "1"
            },
            "content_version": {
              "$numberInt": "1"
            }
          }
        }
      ]
    }
  ]
}
