{
  "collections": [
    {
      "name": "items",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "public_id",
          "masjid_id",
          "type",
          "status",
          "audience",
          "is_important",
          "notify",
          "masjid_visible",
          "created_by",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "public_id": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "12"
            },
            "pattern": "^[A-Za-z0-9_-]{12}$"
          },
          "masjid_id": {
            "bsonType": "binData"
          },
          "type": {
            "bsonType": "string",
            "enum": [
              "announcement",
              "daily_content",
              "dua_request",
              "campaign",
              "chanda_update",
              "video",
              "timing_update"
            ]
          },
          "status": {
            "bsonType": "string",
            "enum": ["draft", "published", "hidden", "deleted", "removed"]
          },
          "audience": {
            "bsonType": "string",
            "enum": ["everyone", "brothers", "sisters"]
          },
          "title": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "120"
            }
          },
          "body": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "1500"
            }
          },
          "content_locale": {
            "bsonType": "string",
            "enum": ["en", "hi", "ur", "te"]
          },
          "template_key": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "64"
            },
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "template_params": {
            "bsonType": "object"
          },
          "is_important": {
            "bsonType": "bool"
          },
          "image_key": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "200"
            }
          },
          "image_thumbhash": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "64"
            }
          },
          "rights_confirmed": {
            "bsonType": "bool"
          },
          "notify": {
            "bsonType": "bool"
          },
          "masjid_visible": {
            "bsonType": "bool"
          },
          "published_at": {
            "bsonType": "date"
          },
          "published_version": {
            "bsonType": "long",
            "minimum": {
              "$numberLong": "1"
            },
            "maximum": {
              "$numberLong": "9007199254740991"
            }
          },
          "edited_at": {
            "bsonType": "date"
          },
          "created_by": {
            "bsonType": "binData"
          },
          "deleted_at": {
            "bsonType": "date"
          },
          "removed_at": {
            "bsonType": "date"
          },
          "hidden_at": {
            "bsonType": "date"
          },
          "removed_reason": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "300"
            }
          },
          "removed_note": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "500"
            }
          },
          "purge_after": {
            "bsonType": "date"
          },
          "voice": {
            "bsonType": "object",
            "required": ["key", "duration_s"],
            "additionalProperties": false,
            "properties": {
              "key": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "200"
                },
                "pattern": "^m/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/a/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "duration_s": {
                "bsonType": "int",
                "minimum": {
                  "$numberInt": "1"
                },
                "maximum": {
                  "$numberInt": "600"
                }
              },
              "peaks": {
                "bsonType": "array",
                "items": {
                  "bsonType": "int",
                  "minimum": {
                    "$numberInt": "0"
                  },
                  "maximum": {
                    "$numberInt": "255"
                  }
                },
                "maxItems": {
                  "$numberInt": "48"
                }
              }
            }
          },
          "announcement": {
            "bsonType": "object",
            "required": ["category"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "bsonType": "string",
                "enum": ["general", "event", "facilities", "timing"]
              },
              "event_at": {
                "bsonType": "date"
              }
            }
          },
          "daily": {
            "bsonType": "object",
            "required": ["library_id", "kind"],
            "additionalProperties": false,
            "properties": {
              "library_id": {
                "bsonType": "binData"
              },
              "kind": {
                "bsonType": "string",
                "enum": ["hadith", "ayah"]
              },
              "note": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "200"
                }
              }
            }
          },
          "dua": {
            "bsonType": "object",
            "required": ["category", "name_private", "library_id"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "bsonType": "string",
                "enum": ["illness", "inteqal", "other"]
              },
              "person_name": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "80"
                }
              },
              "name_private": {
                "bsonType": "bool"
              },
              "library_id": {
                "bsonType": "binData"
              },
              "janaza_at": {
                "bsonType": "date"
              },
              "janaza_place": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "archived_at": {
                "bsonType": "date"
              }
            }
          },
          "campaign": {
            "bsonType": "object",
            "required": ["purpose", "target_paise", "received_paise", "starts_on", "status", "payment_profile_id"],
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "bsonType": "string",
                "enum": ["renovation", "repair", "utilities", "welfare", "other"]
              },
              "target_paise": {
                "bsonType": "long",
                "minimum": {
                  "$numberLong": "100000"
                },
                "maximum": {
                  "$numberLong": "1000000000000"
                }
              },
              "received_paise": {
                "bsonType": "long",
                "minimum": {
                  "$numberLong": "0"
                },
                "maximum": {
                  "$numberLong": "1000000000000"
                }
              },
              "received_updated_at": {
                "bsonType": "date"
              },
              "received_updated_by": {
                "bsonType": "binData"
              },
              "starts_on": {
                "bsonType": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              "ends_on": {
                "bsonType": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              "status": {
                "bsonType": "string",
                "enum": ["active", "completed", "closed"]
              },
              "payment_profile_id": {
                "bsonType": "binData"
              },
              "cover_key": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "200"
                }
              },
              "cover_thumbhash": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "64"
                }
              }
            }
          },
          "chanda": {
            "bsonType": "object",
            "required": ["chanda_week_id", "week_start", "amount_paise", "visible"],
            "additionalProperties": false,
            "properties": {
              "chanda_week_id": {
                "bsonType": "binData"
              },
              "week_start": {
                "bsonType": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              "amount_paise": {
                "bsonType": "long",
                "minimum": {
                  "$numberLong": "0"
                },
                "maximum": {
                  "$numberLong": "1000000000000"
                }
              },
              "visible": {
                "bsonType": "bool"
              }
            }
          },
          "video": {
            "bsonType": "object",
            "required": ["youtube_id", "thumb_key", "thumb_thumbhash"],
            "additionalProperties": false,
            "properties": {
              "youtube_id": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "11"
                },
                "pattern": "^[A-Za-z0-9_-]{11}$"
              },
              "start_s": {
                "bsonType": "int",
                "minimum": {
                  "$numberInt": "0"
                },
                "maximum": {
                  "$numberInt": "86400"
                }
              },
              "speaker": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "80"
                }
              },
              "thumb_key": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "200"
                }
              },
              "thumb_thumbhash": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "64"
                }
              }
            }
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          }
        },
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": ["announcement", "timing_update"]
              }
            },
            "required": ["announcement"],
            "not": {
              "anyOf": [
                {
                  "required": ["daily"]
                },
                {
                  "required": ["dua"]
                },
                {
                  "required": ["campaign"]
                },
                {
                  "required": ["chanda"]
                },
                {
                  "required": ["video"]
                }
              ]
            }
          },
          {
            "properties": {
              "type": {
                "enum": ["daily_content"]
              }
            },
            "required": ["daily"],
            "not": {
              "anyOf": [
                {
                  "required": ["announcement"]
                },
                {
                  "required": ["dua"]
                },
                {
                  "required": ["campaign"]
                },
                {
                  "required": ["chanda"]
                },
                {
                  "required": ["video"]
                }
              ]
            }
          },
          {
            "properties": {
              "type": {
                "enum": ["dua_request"]
              }
            },
            "required": ["dua"],
            "not": {
              "anyOf": [
                {
                  "required": ["announcement"]
                },
                {
                  "required": ["daily"]
                },
                {
                  "required": ["campaign"]
                },
                {
                  "required": ["chanda"]
                },
                {
                  "required": ["video"]
                }
              ]
            }
          },
          {
            "properties": {
              "type": {
                "enum": ["campaign"]
              }
            },
            "required": ["campaign"],
            "not": {
              "anyOf": [
                {
                  "required": ["announcement"]
                },
                {
                  "required": ["daily"]
                },
                {
                  "required": ["dua"]
                },
                {
                  "required": ["chanda"]
                },
                {
                  "required": ["video"]
                }
              ]
            }
          },
          {
            "properties": {
              "type": {
                "enum": ["chanda_update"]
              }
            },
            "required": ["chanda"],
            "not": {
              "anyOf": [
                {
                  "required": ["announcement"]
                },
                {
                  "required": ["daily"]
                },
                {
                  "required": ["dua"]
                },
                {
                  "required": ["campaign"]
                },
                {
                  "required": ["video"]
                }
              ]
            }
          },
          {
            "properties": {
              "type": {
                "enum": ["video"]
              }
            },
            "required": ["video"],
            "not": {
              "anyOf": [
                {
                  "required": ["announcement"]
                },
                {
                  "required": ["daily"]
                },
                {
                  "required": ["dua"]
                },
                {
                  "required": ["campaign"]
                },
                {
                  "required": ["chanda"]
                }
              ]
            }
          }
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "not": {
                  "required": ["voice"]
                }
              },
              {
                "required": ["title"],
                "properties": {
                  "type": {
                    "enum": ["announcement", "daily_content", "dua_request"]
                  }
                }
              }
            ]
          }
        ]
      },
      "indexes": [
        {
          "name": "public_id_unique",
          "key": {
            "public_id": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "feed_status",
          "key": {
            "masjid_id": {
              "$numberInt": "1"
            },
            "status": {
              "$numberInt": "1"
            },
            "published_at": {
              "$numberInt": "-1"
            },
            "_id": {
              "$numberInt": "-1"
            }
          }
        },
        {
          "name": "feed_type",
          "key": {
            "masjid_id": {
              "$numberInt": "1"
            },
            "type": {
              "$numberInt": "1"
            },
            "status": {
              "$numberInt": "1"
            },
            "published_at": {
              "$numberInt": "-1"
            },
            "_id": {
              "$numberInt": "-1"
            }
          }
        },
        {
          "name": "feed_audience_published",
          "key": {
            "masjid_id": {
              "$numberInt": "1"
            },
            "audience": {
              "$numberInt": "1"
            },
            "status": {
              "$numberInt": "1"
            },
            "published_at": {
              "$numberInt": "-1"
            },
            "_id": {
              "$numberInt": "-1"
            }
          },
          "partialFilterExpression": {
            "status": "published"
          }
        },
        {
          "name": "purge_after",
          "key": {
            "purge_after": {
              "$numberInt": "1"
            }
          },
          "partialFilterExpression": {
            "purge_after": {
              "$type": "date"
            }
          }
        },
        {
          "name": "campaign_status_ends",
          "key": {
            "campaign.status": {
              "$numberInt": "1"
            },
            "campaign.ends_on": {
              "$numberInt": "1"
            }
          },
          "partialFilterExpression": {
            "type": "campaign"
          }
        }
      ]
    }
  ],
  "views": []
}
