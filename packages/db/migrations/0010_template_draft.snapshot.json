{
  "collections": [
    {
      "name": "notice_templates",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "category",
          "icon",
          "is_important_default",
          "title",
          "body",
          "params",
          "status",
          "translation_reviewed",
          "system",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "64"
            },
            "pattern": "^[a-z0-9_]{1,64}$"
          },
          "category": {
            "bsonType": "string",
            "enum": ["general", "event", "facilities", "timing"]
          },
          "icon": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "40"
            }
          },
          "is_important_default": {
            "bsonType": "bool"
          },
          "title": {
            "bsonType": "object",
            "required": ["en", "hi", "ur", "te"],
            "additionalProperties": false,
            "properties": {
              "en": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "hi": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "ur": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              },
              "te": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "120"
                }
              }
            }
          },
          "body": {
            "bsonType": "object",
            "required": ["en", "hi", "ur", "te"],
            "additionalProperties": false,
            "properties": {
              "en": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "1500"
                }
              },
              "hi": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "1500"
                }
              },
              "ur": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "1500"
                }
              },
              "te": {
                "bsonType": "string",
                "maxLength": {
                  "$numberInt": "1500"
                }
              }
            }
          },
          "params": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["name", "type", "required"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "bsonType": "string",
                  "maxLength": {
                    "$numberInt": "40"
                  },
                  "pattern": "^[a-z][a-zA-Z0-9_]*$"
                },
                "type": {
                  "bsonType": "string",
                  "enum": ["time", "date", "date_range", "time_range", "prayer", "number", "short_text", "phone"]
                },
                "required": {
                  "bsonType": "bool"
                }
              }
            },
            "maxItems": {
              "$numberInt": "10"
            }
          },
          "status": {
            "bsonType": "string",
            "enum": ["draft", "active", "retired"]
          },
          "translation_reviewed": {
            "bsonType": "bool"
          },
          "system": {
            "bsonType": "bool"
          },
          "created_at": {
            "bsonType": "date"
          },
          "updated_at": {
            "bsonType": "date"
          }
        }
      },
      "indexes": []
    }
  ],
  "views": []
}
