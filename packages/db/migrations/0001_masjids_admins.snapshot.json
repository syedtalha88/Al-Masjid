            "bsonType": "binData"
          },
          "admin_id": {
            "bsonType": "binData"
          },
          "role": {
            "bsonType": "string",
            "enum": ["owner", "editor"]
          },
          "added_by": {
            "bsonType": "binData"
          },
          "created_at": {
            "bsonType": "date"
          }
        }
      },
      "indexes": [
        {
          "name": "masjid_admin_unique",
          "key": {
            "masjid_id": {
              "$numberInt": "1"
            },
            "admin_id": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "admin",
          "key": {
            "admin_id": {
              "$numberInt": "1"
            }
          }
        }
      ]
    },
    {
      "name": "webauthn_credentials",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "admin_id",
          "credential_id",
          "public_key",
          "sign_count",
          "transports",
          "backed_up",
          "device_type",
          "label",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "admin_id": {
            "bsonType": "binData"
          },
          "credential_id": {
            "bsonType": "binData"
          },
          "public_key": {
            "bsonType": "binData"
          },
          "sign_count": {
            "bsonType": "long",
            "minimum": {
              "$numberLong": "0"
            },
            "maximum": {
              "$numberLong": "4294967295"
            }
          },
          "transports": {
            "bsonType": "array",
            "items": {
              "bsonType": "string",
              "maxLength": {
                "$numberInt": "20"
              }
            },
            "maxItems": {
              "$numberInt": "10"
            }
          },
          "aaguid": {
            "bsonType": "binData"
          },
          "backed_up": {
            "bsonType": "bool"
          },
          "device_type": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "32"
            }
          },
          "label": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "60"
            }
          },
          "created_at": {
            "bsonType": "date"
          },
          "last_used_at": {
            "bsonType": "date"
          },
          "revoked_at": {
            "bsonType": "date"
          }
        }
      },
      "indexes": [
        {
          "name": "credential_id_unique",
          "key": {
            "credential_id": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "admin",
          "key": {
            "admin_id": {
              "$numberInt": "1"
            }
          }
        }
      ]
    },
    {
      "name": "admin_invites",
      "jsonSchema": {
        "bsonType": "object",
        "required": ["_id", "admin_id", "purpose", "token_hash", "expires_at", "open", "created_by", "created_at"],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "admin_id": {
            "bsonType": "binData"
          },
          "purpose": {
            "bsonType": "string",
            "enum": ["register", "add_device", "recovery"]
          },
          "token_hash": {
            "bsonType": "binData"
          },
          "expires_at": {
            "bsonType": "date"
          },
          "used_at": {
            "bsonType": "date"
          },
          "open": {
            "bsonType": "bool"
          },
          "created_by": {
            "bsonType": "binData"
          },
          "created_at": {
            "bsonType": "date"
          }
        }
      },
      "indexes": [
        {
          "name": "token_hash_unique",
          "key": {
            "token_hash": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "open_invite_unique",
          "key": {
            "admin_id": {
              "$numberInt": "1"
            },
            "purpose": {
              "$numberInt": "1"
            }
          },
          "unique": true,
          "partialFilterExpression": {
            "open": true
          }
        }
      ]
    },
    {
      "name": "admin_sessions",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "admin_id",
          "token_hash",
          "created_at",
          "last_seen_at",
          "idle_expires_at",
          "absolute_expires_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "admin_id": {
            "bsonType": "binData"
          },
          "token_hash": {
            "bsonType": "binData"
          },
          "created_at": {
            "bsonType": "date"
          },
          "last_seen_at": {
            "bsonType": "date"
          },
          "idle_expires_at": {
            "bsonType": "date"
          },
          "absolute_expires_at": {
            "bsonType": "date"
          },
          "step_up_at": {
            "bsonType": "date"
          },
          "ua_summary": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "120"
            }
          },
          "revoked_at": {
            "bsonType": "date"
          },
          "revoked_reason": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "80"
            }
          }
        }
      },
      "indexes": [
        {
          "name": "token_hash_unique",
          "key": {
            "token_hash": {
              "$numberInt": "1"
            }
          },
          "unique": true
        },
        {
          "name": "admin_revoked",
          "key": {
            "admin_id": {
              "$numberInt": "1"
            },
            "revoked_at": {
              "$numberInt": "1"
            }
          }
        },
        {
          "name": "absolute_expires",
          "key": {
