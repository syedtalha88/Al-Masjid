{
  "collections": [
    {
      "name": "reports",
      "jsonSchema": {
        "bsonType": "object",
        "required": [
          "_id",
          "target_type",
          "target_id",
          "masjid_id",
          "reason",
          "urgent",
          "status",
          "sla_due_at",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "_id": {
            "bsonType": "binData"
          },
          "target_type": {
            "bsonType": "string",
            "enum": ["item", "masjid"]
          },
          "target_id": {
            "bsonType": "binData"
          },
          "masjid_id": {
            "bsonType": "binData"
          },
          "reason": {
            "bsonType": "string",
            "enum": ["misleading", "hateful", "off_topic", "fraud", "private_info", "copyright", "other"]
          },
          "details": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "500"
            }
          },
          "device_id": {
            "bsonType": "binData"
          },
          "urgent": {
            "bsonType": "bool"
          },
          "status": {
            "bsonType": "string",
            "enum": ["open", "actioned", "dismissed"]
          },
          "sla_due_at": {
            "bsonType": "date"
          },
          "actioned_by": {
            "bsonType": "binData"
          },
          "actioned_at": {
            "bsonType": "date"
          },
          "resolution_note": {
            "bsonType": "string",
            "maxLength": {
              "$numberInt": "500"
            }
          },
          "created_at": {
            "bsonType": "date"
          },
          "closed_at": {
            "bsonType": "date"
          },
          "triaged_at": {
            "bsonType": "date"
          },
          "sla_alerted": {
            "bsonType": "int",
            "minimum": {
              "$numberInt": "0"
            },
            "maximum": {
              "$numberInt": "100"
            }
          }
        }
      },
      "indexes": [
        {
          "name": "status_sla",
          "key": {
            "status": {
              "$numberInt": "1"
            },
            "sla_due_at": {
              "$numberInt": "1"
            }
          }
        },
        {
          "name": "target_created",
          "key": {
            "target_id": {
              "$numberInt": "1"
            },
            "created_at": {
              "$numberInt": "-1"
            }
          }
        },
        {
          "name": "masjid_created",
          "key": {
            "masjid_id": {
              "$numberInt": "1"
            },
            "created_at": {
              "$numberInt": "-1"
            }
          }
        },
        {
          "name": "device",
          "key": {
            "device_id": {
              "$numberInt": "1"
            }
          },
          "partialFilterExpression": {
            "device_id": {
              "$exists": true
            }
          }
        }
      ]
    }
  ],
  "views": []
}
